# Required: encryption key for API keys at rest (generate with: openssl rand -hex 32)
ENCRYPTION_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Optional but recommended: separate HMAC key for hashing relay tokens at rest
# If not set, falls back to ENCRYPTION_SECRET (still safe, but using separate keys is best practice)
# Generate with: openssl rand -hex 32
# TOKEN_HMAC_SECRET=change-me-to-another-random-secret-at-least-32-chars

# Optional: salt for the API key encryption KDF (generate with: openssl rand -hex 32)
# Defaults to a built-in value for backward compatibility — set this on fresh deployments
# ENCRYPTION_SALT=change-me-to-a-random-salt

# Optional but strongly recommended: gate POST /users with a shared secret.
# If set, all calls to POST /users must supply:
#   Authorization: Bearer <APP_SECRET>
# Without this, anyone who can reach your relay can register unlimited users.
# Generate with: openssl rand -hex 32
# APP_SECRET=change-me-to-a-random-secret

# Port to listen on (default: 3000)
PORT=3000

# Comma-separated list of allowed CORS origins
# Production: restrict to your app's domain(s)
# Example: https://myfreetimeinaweek.in,https://anotherapp.example.com
# Development: add localhost ports as needed
ALLOWED_ORIGINS=https://yourapp.example.com,http://localhost:3000,http://localhost:19006

# Path to SQLite database file (default: ./data/relay.db)
# DB_PATH=./data/relay.db

# Optional: comma-separated list of AI models permitted on this relay.
# Supports exact names and '*' wildcards (e.g. "gpt-4o*" matches all gpt-4o variants).
# If not set, all models are permitted (open relay — any model the user's API key can access).
# Use this to prevent users from requesting expensive models in team deployments.
# GET /models returns the current allowlist (or { restricted: false } if unset).
# Example: ALLOWED_MODELS=gpt-4o-mini,claude-haiku*,gemini-2.0-flash*
# ALLOWED_MODELS=
