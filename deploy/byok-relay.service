[Unit]
Description=BYOK Relay Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/byok-relay
ExecStart=/usr/bin/node src/index.js
ExecStartPost=/bin/bash -c 'chmod 600 /home/ubuntu/byok-relay/data/relay.db 2>/dev/null || true; chmod 600 /home/ubuntu/byok-relay/data/relay.db-wal 2>/dev/null || true; chmod 600 /home/ubuntu/byok-relay/data/relay.db-shm 2>/dev/null || true'
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=byok-relay

# Environment — copy .env.example to .env and fill in values
# The EnvironmentFile directive loads .env automatically
EnvironmentFile=/home/ubuntu/byok-relay/.env

[Install]
WantedBy=multi-user.target
